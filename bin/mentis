#!/usr/bin/env bash
#
# mentis — wrapper CLI.
#
# Installazione (una volta):
#   ln -s "$(pwd)/bin/mentis" /usr/local/bin/mentis   # oppure aggiungi bin/ al PATH
#
# Uso:  mentis build "app TODO" --project ~/dev/todo
#       mentis status --project ~/dev/todo
#       mentis doctor --provider codex --models "..."
#
set -euo pipefail

# Risoluzione portabile del path reale (segue i symlink; funziona anche su macOS,
# dove `readlink -f` non esiste).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

exec python3 "$ROOT/orchestrator/mentis.py" "$@"
